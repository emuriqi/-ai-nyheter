# Kopier til .env og fyll inn. .env skal aldri committes.

# SQLite-fil, relativ til prosjektroten.
DATABASE_URL="file:./prisma/dev.db"

# Passord for /admin (brukernavn: admin). Må være tilfeldig og minst 24 tegn,
# lag et med: openssl rand -base64 32
# Admin er avslått når feltet er tomt eller for svakt.
ADMIN_TOKEN=""

# Hemmelighet cron-jobben sender som «Authorization: Bearer <CRON_SECRET>» til
# POST /api/cron/ingest. Tilfeldig og minst 24 tegn (openssl rand -base64 32).
# Ruten er avslått når feltet er tomt eller for svakt.
CRON_SECRET=""

# Nøkkel til Claude API. Valgfri: uten nøkkel avgjør ikke Claude gråsonen i
# grupperingen, og elementene der blir egne saker (fase 3). Kreves for
# generering fra fase 4. Lag en på https://console.anthropic.com/.
ANTHROPIC_API_KEY=""
