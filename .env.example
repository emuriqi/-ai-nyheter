# Kopier til .env og fyll inn. .env skal aldri committes.

# SQLite-fil, relativ til prosjektroten.
DATABASE_URL="file:./prisma/dev.db"

# Passord for /admin (brukernavn: admin). Admin er avslått hvis tom.
ADMIN_TOKEN=""

# Hemmelighet cron-jobben sender som «Authorization: Bearer <CRON_SECRET>» (fase 2).
CRON_SECRET=""

# Nøkkel til Claude API (fase 4).
ANTHROPIC_API_KEY=""
